#!/usr/bin/env bash
# verify-naia-image.sh — in-build assertion that the image actually contains
# what it claims to.
#
# The pipeline this replaces shipped an ISO whose live session had no shell:
# the Flatpak install step ended in `|| true`, so a failed install produced a
# green build and a dead launcher. Every check here is a hard failure. Nothing
# in this file may end in `|| true`.
#
# Runs after the rpm-ostree and files modules.

set -euo pipefail

# ROOT lets the same predicate run against a fixture tree instead of /, so this
# gate can be proven to both fail and pass before it ever reaches CI. The image
# build leaves it unset.
ROOT="${ROOT:-}"
RPM_ROOT_ARG=()
[ -n "$ROOT" ] && RPM_ROOT_ARG=(--root "$(readlink -f "$ROOT")")

fail() {
    echo "[verify] FAIL: $*" >&2
    exit 1
}

ok() { echo "[verify] ok: $*"; }

# --- The layered shell ------------------------------------------------------
# The RPM package is named `naia`; the binary it installs is `naia-shell`.
# These differ, and asserting the wrong one is a false RED.
rpm "${RPM_ROOT_ARG[@]+"${RPM_ROOT_ARG[@]}"}" -q naia >/dev/null 2>&1 || fail "naia RPM is not layered into the image"
ok "naia RPM layered: $(rpm "${RPM_ROOT_ARG[@]+"${RPM_ROOT_ARG[@]}"}" -q naia)"

[ -x ${ROOT}/usr/bin/naia-shell ] || fail "${ROOT}/usr/bin/naia-shell missing or not executable"
ok "${ROOT}/usr/bin/naia-shell is executable"

# The shell links against a vendored libvosk.so resolved through RUNPATH
# ($ORIGIN/../lib/Naia). A missing or unresolvable library crashes the app on
# launch with no window and no log the user would see, so resolve it here.
[ -f ${ROOT}/usr/lib/Naia/libvosk.so ] || fail "${ROOT}/usr/lib/Naia/libvosk.so missing"
if ldd "${ROOT}/usr/bin/naia-shell" 2>&1 | grep -q "not found"; then
    echo "[verify] unresolved libraries:" >&2
    ldd "${ROOT}/usr/bin/naia-shell" 2>&1 | grep "not found" >&2
    fail "naia-shell has unresolved shared libraries"
fi
ok "naia-shell dynamic dependencies all resolve"

[ -f ${ROOT}/usr/lib/Naia/node ] || fail "${ROOT}/usr/lib/Naia/node (bundled agent runtime) missing"
ok "bundled node runtime present"

# --- The desktop entry the launchers point at -------------------------------
# branding.sh pins "applications:Naia.desktop" to the taskbar and the ISO hook
# prepends it to Kickoff favorites. KDE drops an unknown launcher silently, so
# a rename in the RPM would go unnoticed until a user looked at the taskbar.
[ -f ${ROOT}/usr/share/applications/Naia.desktop ] \
    || fail "${ROOT}/usr/share/applications/Naia.desktop missing — taskbar pin and Kickoff favorite would silently point at nothing"
grep -q '^Exec=naia-shell' ${ROOT}/usr/share/applications/Naia.desktop \
    || fail "Naia.desktop Exec= does not launch naia-shell"
ok "Naia.desktop present and launches naia-shell"

# --- Branding ---------------------------------------------------------------
grep -q '^ID=naia-os' ${ROOT}/usr/lib/os-release || fail "os-release not rebranded (ID != naia-os)"
grep -q '^NAIA_VERSION=' ${ROOT}/usr/lib/os-release || fail "os-release has no NAIA_VERSION"
ok "os-release rebranded: $(grep '^PRETTY_NAME=' ${ROOT}/usr/lib/os-release)"

# --- Installer assets the ISO hook reads ------------------------------------
# The hook runs later, inside the extracted image, and reads these from disk.
# It used to clone them from a repository that has since become a tombstone.
for asset in \
    ${ROOT}/usr/share/naia/assets/installer/sidebar-logo.png \
    ${ROOT}/usr/share/naia/assets/installer/sidebar-bg.png \
    ${ROOT}/usr/share/naia/assets/installer/topbar-bg.png \
    ${ROOT}/usr/share/naia/assets/installer/anaconda_header.png \
    ${ROOT}/usr/share/naia/assets/installer/anaconda-installer.svg \
    ${ROOT}/usr/share/naia/assets/installer/fedora.css \
    ${ROOT}/usr/share/naia/assets/installer/live-wallpaper.jpg \
    ${ROOT}/usr/share/naia/assets/installer/start-here.svg \
    ${ROOT}/usr/share/naia/assets/logos/text-mix-naia-logo.png
do
    [ -f "$asset" ] || fail "installer asset missing: $asset"
done
ok "all installer assets baked into the image"

# --- GTK backend selection --------------------------------------------------
# naia-shell forces GDK_BACKEND=x11 whenever GDK_BACKEND is unset and DISPLAY is
# set. On KDE Wayland, XWayland provides DISPLAY, so the binary puts itself on
# X11 and its main window maps at 1x1 — running, connected, invisible. The
# Flatpak build had a launcher wrapper for this; the RPM calls the binary
# directly, so the session environment has to make the choice instead.
#
# Every automated check passes without this file. That is exactly why it is
# asserted here.
GDK_ENV="${ROOT}/usr/etc/xdg/plasma-workspace/env/naia-gdk-backend.sh"
[ -f "$GDK_ENV" ] || fail "GTK backend selection missing at $GDK_ENV — the shell would force x11 and map a 1x1 window on KDE Wayland"
grep -q 'GDK_BACKEND=wayland' "$GDK_ENV" || fail "backend selection never selects wayland"
grep -q 'GDK_BACKEND=x11' "$GDK_ENV" || fail "backend selection never selects x11"
(
    out="$(env -i sh -c "export XDG_SESSION_TYPE=wayland; . '$GDK_ENV'; printf %s \"\$GDK_BACKEND\"")"
    [ "$out" = "wayland" ] || { echo "[verify] FAIL: wayland session resolves to '$out', not wayland" >&2; exit 1; }
    out="$(env -i sh -c "export XDG_SESSION_TYPE=x11; . '$GDK_ENV'; printf %s \"\$GDK_BACKEND\"")"
    [ "$out" = "x11" ] || { echo "[verify] FAIL: x11 session resolves to '$out', not x11" >&2; exit 1; }
) || exit 1
ok "GTK backend selection present and resolves correctly for both session types"

# --- Flatpak retirement -----------------------------------------------------
# Machines updating from an image that shipped the Flatpak keep it in mutable
# /var/lib/flatpak, which no image update touches. Without this unit the user
# goes on launching the old shell from the old exported desktop entry and
# nothing reports a problem.
[ -x "${ROOT}/usr/libexec/naia-flatpak-migration" ] \
    || fail "${ROOT}/usr/libexec/naia-flatpak-migration missing — machines updating from the Flatpak image would keep running the old shell"
[ -f "${ROOT}/usr/lib/systemd/system/naia-flatpak-migration.service" ] \
    || fail "naia-flatpak-migration.service missing"
ok "Flatpak retirement path present"

# --- Autostart --------------------------------------------------------------
[ -f ${ROOT}/usr/etc/xdg/autostart/naia-shell.desktop ] || fail "autostart entry missing"
grep -q 'naia-shell' ${ROOT}/usr/etc/xdg/autostart/naia-shell.desktop \
    || fail "autostart entry does not reference naia-shell"
ok "autostart entry present"

# --- No Flatpak residue -----------------------------------------------------
# The shell moved from a Flatpak bundle to a layered RPM. A leftover reference
# would launch nothing.
if grep -rl 'io\.nextain\.naia' "${ROOT}/usr/share/plasma" "${ROOT}/etc/xdg" "${ROOT}/usr/etc/xdg" 2>/dev/null | grep -q .; then
    grep -rl 'io\.nextain\.naia' "${ROOT}/usr/share/plasma" "${ROOT}/etc/xdg" "${ROOT}/usr/etc/xdg" 2>/dev/null >&2
    fail "stale Flatpak app-id references remain in the image"
fi
ok "no stale io.nextain.naia references"

echo "[verify] all image assertions passed"
