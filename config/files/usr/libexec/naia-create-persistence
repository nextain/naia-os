#!/usr/bin/env bash
# naia-create-persistence — claim the free space after the ISO for user data.
#
# `dd if=naia-os-live.iso of=/dev/sdX` reproduces the ISO byte for byte, so a
# 16GB stick ends up with ~7.6GB of image and the rest unallocated. This adds one
# partition in that free space, labeled naia-data, which var-home-liveuser.mount
# then attaches as the live user's home.
#
# Doing it here rather than in a flashing tool is what makes it work everywhere:
# whoever wrote the stick — dd, Rufus, balenaEtcher, on any OS — the persistence
# appears on first boot.
#
# This writes a partition table, so every condition below is a refusal, not a
# warning. It runs unattended on hardware nobody has inspected.

set -uo pipefail

log()  { printf '[naia-persist] %s\n' "$*"; }
skip() { printf '[naia-persist] skipping: %s\n' "$*"; exit 0; }

# 1. Already done? The mount unit will pick it up; nothing to do.
if blkid -L naia-data >/dev/null 2>&1; then
    skip "naia-data already exists"
fi

# 2. Only ever touch the medium this system booted from. Anything else is
#    somebody's disk.
BOOT_SRC="$(findmnt -no SOURCE /run/initramfs/live 2>/dev/null || true)"
[ -n "$BOOT_SRC" ] || BOOT_SRC="$(findmnt -no SOURCE /run/rootfsbase 2>/dev/null || true)"
[ -n "$BOOT_SRC" ] || skip "cannot identify the boot medium — not a live boot"

DISK="/dev/$(lsblk -no PKNAME "$BOOT_SRC" 2>/dev/null | head -1)"
[ -b "$DISK" ] || skip "cannot resolve the boot disk from $BOOT_SRC"

# 3. Removable only. An internal disk that happens to hold the live image is not
#    a stick somebody expects to be repartitioned.
[ "$(lsblk -dno RM "$DISK" 2>/dev/null)" = "1" ] || skip "$DISK is not removable"
[ "$(lsblk -dno TRAN "$DISK" 2>/dev/null)" = "usb" ] || skip "$DISK is not USB-attached"

# 4. Never the disk holding the running root. Belt and braces with (3): an
#    installed system must never reach the code below.
ROOT_SRC="$(findmnt -no SOURCE / 2>/dev/null || true)"
if [ -n "$ROOT_SRC" ]; then
    ROOT_DISK="$(lsblk -no PKNAME "$ROOT_SRC" 2>/dev/null | head -1)"
    [ "/dev/${ROOT_DISK:-none}" != "$DISK" ] || skip "$DISK carries the running root"
fi

# 5. Every tool used below must actually exist in the image. gdisk is NOT in the
#    Naia OS image (verified: `rpm -q gdisk` → not installed), so an sgdisk-based
#    implementation would find nothing and refuse on every boot without saying
#    why. parted, partprobe, mkfs.btrfs, blkid and udevadm are all present.
for tool in parted partprobe mkfs.btrfs blkid; do
    command -v "$tool" >/dev/null 2>&1 || skip "$tool is missing from this image"
done

# 6. An isohybrid image carries a GPT sized to the image rather than the stick,
#    so the backup header sits just past the ISO. parted repairs that on its own
#    when it sees the mismatch; feeding it a no-op print with 'Fix' accepted
#    moves the header to the true end of the device without touching a partition.
parted -s -f "$DISK" print >/dev/null 2>&1 || true

# 7. Enough unallocated space at the end to be worth it. Below 1GiB there is no
#    point taking the risk of a partition write.
#
#    parted reports free space directly, which is also what a human sees; the
#    numbers here matched a real 16GB stick (7388MiB free after a 7.6GiB ISO).
read -r FREE_START_MIB FREE_END_MIB <<<"$(
    parted -sm "$DISK" unit MiB print free 2>/dev/null |
    awk -F: '$5 ~ /free/ { gsub(/MiB/,"",$2); gsub(/MiB/,"",$3); s=$2; e=$3 }
             END { if (s != "") print s, e }'
)"
[ -n "${FREE_START_MIB:-}" ] || skip "no free space reported on $DISK"
END_FREE_MIB=$(( ${FREE_END_MIB%.*} - ${FREE_START_MIB%.*} ))
[ "$END_FREE_MIB" -ge 1024 ] || skip "only ${END_FREE_MIB}MiB free at the end of $DISK"

# 7. Nothing on this disk may be mounted read-write while its table changes.
#    The live ISO partition itself is mounted read-only and is expected.
BAD="$(lsblk -nrpo NAME,MOUNTPOINT "$DISK" | awk '$2 != "" && $2 != "/run/initramfs/live" { print $1" -> "$2 }')"
[ -z "$BAD" ] || skip "mounted partitions on $DISK: $BAD"

log "claiming ${END_FREE_MIB}MiB of free space on $DISK for persistent data"

# Take the free region exactly as reported, leaving the ISO partitions alone.
if ! parted -s -a optimal "$DISK" \
        mkpart naia-data btrfs "${FREE_START_MIB}MiB" "${FREE_END_MIB}MiB" >/dev/null 2>&1; then
    log "ERROR: failed to create the data partition on $DISK"
    exit 1
fi

udevadm settle 2>/dev/null || sleep 2
partprobe "$DISK" >/dev/null 2>&1 || true
udevadm settle 2>/dev/null || sleep 2

PART="$(lsblk -nrpo NAME "$DISK" | tail -1)"
[ -b "$PART" ] || { log "ERROR: partition ${NEXT} did not appear"; exit 1; }

if ! mkfs.btrfs -f -L naia-data "$PART" >/dev/null 2>&1; then
    log "ERROR: mkfs.btrfs failed on $PART"
    exit 1
fi

udevadm settle 2>/dev/null || sleep 2

# Report what the next boot will actually find, not what was intended.
if blkid -L naia-data >/dev/null 2>&1; then
    log "created $PART (naia-data) — settings and data persist from the next boot"
else
    log "ERROR: naia-data label not visible after mkfs"
    exit 1
fi
