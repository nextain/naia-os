#!/usr/bin/env bash
# naia-live-welcome — ask what this live session is for, once, on first boot.
#
# Three things a person can want from a live USB, and they need different setups:
#
#   keep using the USB   → claim the free space after the ISO as a data
#                          partition, then reboot so it can be mounted as the
#                          home directory
#   install to this PC   → point them at the installer; the USB stays untouched
#   just looking         → change nothing
#
# The partition is created only on an explicit choice. Creating it silently and
# telling people afterwards means the first session's work is already lost by the
# time they learn the rule, and repartitioning somebody's stick without asking is
# not ours to do.
#
# The reboot is the honest part: the partition has to exist before systemd mounts
# the home, and by the time this dialog runs the live user is already using one.
# Rather than swapping a home out from under a running session, we say what has
# to happen and let the person decide when.

set -uo pipefail

[ "$(whoami)" = "liveuser" ] || exit 0

STAMP="$HOME/.naia-welcome-done"
[ -e "$STAMP" ] && exit 0

HELPER=/usr/libexec/naia-create-persistence

# Already persistent? Then this stick has been through the flow — say so and stop
# offering to do it again.
if blkid -L naia-data >/dev/null 2>&1; then
    kdialog --title "Naia OS" --msgbox \
"Welcome back / 다시 오셨습니다.

This USB keeps settings across reboots (naia-data).
이 USB는 재부팅 뒤에도 설정을 남깁니다 (naia-data).

Install: desktop → Install to Hard Drive
설치: 바탕화면 → Install to Hard Drive"
    : > "$STAMP"
    exit 0
fi

# --- Language first -----------------------------------------------------------
# Everything after this — this dialog's own follow-ups, the desktop, the
# installer, and the system it installs — follows the choice made here. Each
# language is written in itself, so no translation is needed to find your own.
LANG_CHOICE=$(kdialog --title "Naia OS" --combobox \
"Choose your language / 언어를 선택하세요" \
    "English" "한국어" "日本語" "中文" "Français" "Deutsch" "Español" \
    --default "English" 2>/dev/null)

case "$LANG_CHOICE" in
"한국어")   LOCALE=ko_KR.UTF-8 ;;
"日本語")   LOCALE=ja_JP.UTF-8 ;;
"中文")     LOCALE=zh_CN.UTF-8 ;;
"Français") LOCALE=fr_FR.UTF-8 ;;
"Deutsch")  LOCALE=de_DE.UTF-8 ;;
"Español")  LOCALE=es_ES.UTF-8 ;;
*)          LOCALE=en_US.UTF-8 ;;
esac
LANG_CODE="${LOCALE%%_*}"

# Needs root for /etc and the kickstart; the rest of this script does not.
pkexec /usr/libexec/naia-set-language "$LOCALE" >/tmp/naia-lang.log 2>&1 \
    || echo "[naia-welcome] language setup failed: $(tail -1 /tmp/naia-lang.log)"

# Follow-up copy must match the language just chosen. kdialog has no catalogue;
# keep the strings here so a Korean (etc.) pick is not followed by English.
case "$LANG_CODE" in
ko)
    W_TITLE="Naia OS"
    W_ASK="이 USB를 어떻게 쓸까요?"
    W_KEEP="USB로 쓰기 — 설정과 데이터를 이 USB에 저장"
    W_INSTALL="이 컴퓨터에 설치"
    W_LOOK="그냥 둘러보기"
    W_KEEP_FAIL_TITLE="데이터 파티션을 만들지 못했습니다."
    W_KEEP_READY="이 USB에 저장 공간이 준비됐습니다.

다시 시작한 뒤에 쓰이므로, 지금 세션에서 한 일은 남지 않습니다.

지금 다시 시작할까요?"
    W_KEEP_LATER="알겠습니다. 원할 때 다시 시작하세요.

그 전까지는 지금처럼, 아무것도 저장되지 않습니다."
    W_INSTALL_HINT="바탕화면의 'Install to Hard Drive'(하드 디스크에 설치)를 실행하세요.

언어와 키보드는 설치 중에 고르면 설치된 시스템에도 이어집니다.

이 USB는 바뀌지 않습니다."
    W_LOOK_HINT="둘러보세요.

다시 시작하면 이 세션은 초기화됩니다. 설정을 남기려면
다시 시작해서 'USB로 쓰기'를 고르세요."
    W_BACK="다시 오셨습니다.

이 USB에는 데이터 파티션이 있어 설정·대화·기억이 재부팅 뒤에도 남습니다.

이 컴퓨터에 설치하려면 바탕화면의 'Install to Hard Drive'를 실행하세요."
    ;;
ja)
    W_TITLE="Naia OS"
    W_ASK="このUSBをどう使いますか？"
    W_KEEP="USBで使う — 設定とデータをこのUSBに保存"
    W_INSTALL="このコンピュータにインストール"
    W_LOOK="ちょっと見てみる"
    W_KEEP_FAIL_TITLE="データ領域を作れませんでした。"
    W_KEEP_READY="このUSBに保存領域を用意しました。再起動後に使います。今すぐ再起動しますか？"
    W_KEEP_LATER="必要なときに再起動してください。それまでは保存されません。"
    W_INSTALL_HINT="デスクトップの 'Install to Hard Drive' を実行してください。このUSBは変更しません。"
    W_LOOK_HINT="見て回ってください。再起動するとこのセッションは消えます。"
    W_BACK="おかえりなさい。このUSBにはデータ領域があります。インストールはデスクトップのインストーラから。"
    ;;
zh)
    W_TITLE="Naia OS"
    W_ASK="要怎么使用这支 USB？"
    W_KEEP="用 USB — 把设置和数据保存在这支 USB"
    W_INSTALL="安装到这台电脑"
    W_LOOK="先看看"
    W_KEEP_FAIL_TITLE="无法创建数据分区。"
    W_KEEP_READY="已在 USB 上准备好存储。重启后才会使用。现在重启吗？"
    W_KEEP_LATER="想重启时再重启。在此之前不会保存。"
    W_INSTALL_HINT="请运行桌面上的 'Install to Hard Drive'。不会改动这支 USB。"
    W_LOOK_HINT="先看看即可。重启后本次会话会清空。"
    W_BACK="欢迎回来。这支 USB 已有数据分区。安装请用桌面上的安装程序。"
    ;;
*)
    W_TITLE="Naia OS"
    W_ASK="How do you want to use this USB?"
    W_KEEP="Use this USB — save settings and data on it"
    W_INSTALL="Install onto this computer"
    W_LOOK="Just look around"
    W_KEEP_FAIL_TITLE="Could not set up the data partition."
    W_KEEP_READY="Storage is ready on this USB.

It starts being used after a restart, so anything you do in
this session will not be kept.

Restart now?"
    W_KEEP_LATER="Understood — restart whenever you like.

Until then this session behaves as before: nothing is saved."
    W_INSTALL_HINT="Run 'Install to Hard Drive' on the desktop.

You can pick your language and keyboard during installation,
and they carry over to the installed system.

This USB is not modified."
    W_LOOK_HINT="Have a look around.

This session resets when you restart. To keep your settings,
restart and choose 'Use this USB'."
    W_BACK="Welcome back.

This USB has a data partition, so your settings, conversations
and Naia's memory are kept across reboots.

To install onto this computer, run 'Install to Hard Drive'
on the desktop."
    ;;
esac

# --- No data partition yet: offer the three paths -----------------------------

CHOICE=$(kdialog --title "$W_TITLE" --radiolist \
"$W_ASK" \
    keep    "$W_KEEP" on \
    install "$W_INSTALL" off \
    look    "$W_LOOK" off \
    2>/dev/null)

case "$CHOICE" in
keep)
    if ! pkexec "$HELPER" 2>&1 | tee /tmp/naia-persist.log; then
        kdialog --title "$W_TITLE" --sorry \
"$W_KEEP_FAIL_TITLE

$(tail -3 /tmp/naia-persist.log 2>/dev/null)"
        exit 0
    fi

    if ! blkid -L naia-data >/dev/null 2>&1; then
        kdialog --title "$W_TITLE" --sorry \
"$W_KEEP_FAIL_TITLE

$(tail -3 /tmp/naia-persist.log 2>/dev/null)"
        exit 0
    fi

    : > "$STAMP"
    if kdialog --title "$W_TITLE" --warningyesno "$W_KEEP_READY" ; then
        systemctl reboot
    else
        kdialog --title "$W_TITLE" --msgbox "$W_KEEP_LATER"
    fi
    ;;

install)
    : > "$STAMP"
    kdialog --title "$W_TITLE" --msgbox "$W_INSTALL_HINT"
    ;;

*)
    # Includes an empty choice (dialog dismissed): offer again next boot.
    kdialog --title "$W_TITLE" --msgbox "$W_LOOK_HINT"
    ;;
esac
