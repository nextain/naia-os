#!/usr/bin/env bash
# naia-persist-system — keep system-level settings on the naia-data partition.
#
# The persistent partition is mounted at the live user's home, so anything under
# $HOME already survives a reboot: the KDE display language, fcitx5 input
# settings, Naia's own settings, conversations and memory.
#
# These do not live in $HOME and would be lost:
#
#   /etc/NetworkManager/system-connections   Wi-Fi profiles (root:root, 0600,
#                                            passwords in cleartext)
#   /etc/locale.conf                         system LANG
#   /etc/vconsole.conf                       console keymap
#
# Rejoining a network and re-picking a language on every boot is the difference
# between a demo USB that works and one that does not, so they are bind-mounted
# out of the persistent partition. NetworkManager and systemd keep using their
# normal paths; only the storage moves.
#
# Runs before NetworkManager so the profiles are in place when it reads them.

set -uo pipefail

STORE="/var/home/liveuser/.naia-system"

# Only meaningful when the persistent partition is actually mounted. On an
# installed system, or a live boot from a USB without one, this is a no-op.
mountpoint -q /var/home/liveuser || {
    echo "[naia] no persistent partition — system settings stay ephemeral"
    exit 0
}

mkdir -p "$STORE"

persist_dir() {
    local src="$1" dst="$STORE/$2"
    mkdir -p "$dst"
    # Seed from the image on first boot so nothing starts empty.
    if [ -d "$src" ] && [ -z "$(ls -A "$dst" 2>/dev/null)" ]; then
        cp -a "$src/." "$dst/" 2>/dev/null || true
    fi
    # Wi-Fi profiles hold cleartext passwords. NetworkManager refuses to read a
    # profile that is group- or world-readable, so this is correctness as much
    # as hygiene — a loose mode here silently drops every saved network.
    chown -R root:root "$dst"
    chmod 0700 "$dst"
    find "$dst" -type f -exec chmod 0600 {} + 2>/dev/null || true
    mount --bind "$dst" "$src" && echo "[naia] persisting $src"
}

persist_file() {
    local src="$1" dst="$STORE/$2"
    if [ ! -f "$dst" ]; then
        [ -f "$src" ] && cp -a "$src" "$dst" || : > "$dst"
    fi
    chown root:root "$dst"; chmod 0644 "$dst"
    mount --bind "$dst" "$src" && echo "[naia] persisting $src"
}

persist_dir /etc/NetworkManager/system-connections network
persist_file /etc/locale.conf   locale.conf
persist_file /etc/vconsole.conf vconsole.conf

echo "[naia] system settings persisted under $STORE"
