[Unit]
Description=Create the Naia persistent data partition on first live boot
Documentation=https://github.com/nextain/naia-shell/issues/262
# Live boots only. An installed system has nothing to claim and must never see
# this unit run.
ConditionKernelCommandLine=rd.live.image
ConditionPathExists=!/dev/disk/by-label/naia-data
After=local-fs.target
# The partition has to exist before anything tries to mount it. It will not be
# there on the boot that creates it — that is expected, and the mount picks it
# up on the next one.
Before=var-home-liveuser.mount naia-persist-system.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/naia-create-persistence
RemainAfterExit=yes
# Every refusal inside the script exits 0. A non-zero exit means a write was
# attempted and failed, which is worth seeing in the journal rather than
# retrying blindly against a disk in an unknown state.
Restart=no

[Install]
WantedBy=multi-user.target
