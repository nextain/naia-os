[Unit]
Description=Naia persistent liveuser home
Documentation=https://github.com/nextain/naia-os/issues/262
# Must attach before livesys creates the live user, so livesys sees a
# pre-existing /home/liveuser (uses useradd -M, then chowns + restorecons it)
# and user data lands on the persistent partition instead of the RAM overlay.
#
# NOT enabled, and nothing may Want= or Require= this unit at boot. A freshly
# written USB has no naia-data partition — it appears only after the person
# chooses "keep using this USB" — and a mount that is pulled into the boot
# transaction waits for its device whether or not that device can ever show up.
# systemd then blocks the whole boot for the device job timeout (45s here) and
# fails, which looks exactly like a machine that will not start.
#
# `nofail` and `x-systemd.device-timeout=` do NOT help: both are fstab options
# read by systemd-fstab-generator, and are ignored in a native unit file.
#
# 99-naia-data.rules starts this the moment udev sees the label instead, so the
# no-partition case costs nothing and the with-partition case is not a race:
# the live root comes off the same stick, so the device is already settled.
After=dev-disk-by\x2dlabel-naia\x2ddata.device
Requires=dev-disk-by\x2dlabel-naia\x2ddata.device
Before=livesys.service
ConditionPathExists=/dev/disk/by-label/naia-data
# Live boots only. On an installed system /var/home/liveuser is nobody's home,
# and without this a visiting Naia USB would be mounted over it.
ConditionKernelCommandLine=rd.live.image

[Mount]
What=/dev/disk/by-label/naia-data
Where=/var/home/liveuser
Type=btrfs
Options=defaults,compress=zstd:1,noatime,nodiscard,commit=120,seclabel
